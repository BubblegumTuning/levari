#!/usr/bin/env bash
# zig cc pinned to the legacy 32-bit floor: i386 (x86) with the
# glibc 2.17 importlib floor, -mcpu=pentium2 (see
# tools/zig-legacy32-toolchain.cmake).
# NOT musl: a static musl binary cannot dlopen ("Dynamic loading not
# supported" — measured, zig's musl, static and static-pie, i386 and
# x86_64), which would silently dead-code the SDL dlopen backends
# (X11 video, ALSA audio). gnu target = dynamic libc = dlopen works,
# the floor is the glibc version (measured on the final binary,
# objdump -T), mirroring the x86-64 legacy pipeline (zig-cc-2.17).
# Drops CMake's "-Xlinker --dependency-file=..." (same zig 0.16 lld
# segfault workaround as zig-cc-2.17).
args=(); prev=""; filtered=()
for a in "$@"; do
    if [ "$prev" = "-Xlinker" ] && [ "${a#--dependency-file=}" != "$a" ]; then
        args=("${args[@]:0:${#args[@]}-1}")
        prev=""; continue
    fi
    args+=("$a"); prev="$a"
done
exec zig cc -target x86-linux-gnu.2.17 -mcpu=pentium2 "${args[@]}"
